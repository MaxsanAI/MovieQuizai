---
import type { Quiz } from '../types';

interface Props {
  quiz: Quiz;
}

const { quiz } = Astro.props;
---

<a href={`/quiz/${quiz.slug}`} class="quiz-card" style={`--accent: ${quiz.accentColor}; --gradient: ${quiz.gradient}`}>
  <div class="card-glow"></div>
  <div class="card-content">
    <span class="card-emoji">{quiz.emoji}</span>
    <h3 class="card-title">{quiz.title}</h3>
    <p class="card-subtitle">{quiz.subtitle}</p>
    <div class="card-meta">
      <span class="card-questions">{quiz.questions.length} questions</span>
      <span class="card-results">{quiz.results.length} results</span>
    </div>
    <div class="card-cta">
      <span>Take Quiz</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>

<style>
  .quiz-card {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
    cursor: pointer;
  }

  .quiz-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 20px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: var(--gradient);
    opacity: 0.15;
    transition: opacity var(--transition);
  }

  .quiz-card:hover .card-glow {
    opacity: 0.3;
  }

  .card-content {
    position: relative;
    padding: 24px;
  }

  .card-emoji {
    font-size: 2rem;
    display: block;
    margin-bottom: 12px;
  }

  .card-title {
    font-size: 1.125rem;
    line-height: 1.3;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .card-subtitle {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-bottom: 16px;
  }

  .card-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .card-meta span {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-sm);
  }

  .card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    transition: background var(--transition);
  }

  .quiz-card:hover .card-cta {
    background: var(--accent);
  }
</style>
