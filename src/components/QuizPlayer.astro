---
import type { Quiz } from '../types';

interface Props {
  quiz: Quiz;
}

const { quiz } = Astro.props;
---

<div class="quiz-player" data-quiz-id={quiz.id} data-quiz-slug={quiz.slug}>
  <div class="quiz-progress-bar">
    <div class="quiz-progress-fill" id="progress-fill"></div>
  </div>

  <!-- INTRO -->
  <div class="quiz-screen" id="quiz-start">
    <div class="quiz-start-content">
      <span class="quiz-emoji">{quiz.emoji}</span>

      <div class="cinema-label">MOVIEQUIZ PRESENTS</div>

      <h1 class="quiz-title">{quiz.title}</h1>

      <p class="quiz-subtitle">{quiz.subtitle}</p>

      <p class="quiz-description">{quiz.description}</p>

      <div class="quiz-stats">
        <span>{quiz.questions.length} Questions</span>
        <span>{quiz.results.length} Possible Results</span>
      </div>

      <button class="btn-primary" id="start-btn">
        <span>Start Quiz</span>
        <span class="btn-arrow">→</span>
      </button>
    </div>
  </div>

  <!-- GENDER SELECTION -->
  <div class="quiz-screen hidden" id="quiz-gender">
    <div class="gender-content">
      <div class="cinema-label">PERSONALIZE YOUR RESULT</div>

      <div class="gender-icon">🎬</div>

      <h2 class="gender-title">
        How should we personalize<br />
        your movie character?
      </h2>

      <p class="gender-subtitle">
        Choose your gender so the final character reveal and movie poster
        can be personalized for you.
      </p>

      <div class="gender-options">
        <button class="gender-card" data-gender="male">
          <span class="gender-symbol">♂</span>
          <span class="gender-label">Male</span>
          <span class="gender-check">✓</span>
        </button>

        <button class="gender-card" data-gender="female">
          <span class="gender-symbol">♀</span>
          <span class="gender-label">Female</span>
          <span class="gender-check">✓</span>
        </button>
      </div>

      <p class="gender-note">
        This only affects your personalized result.
      </p>
    </div>
  </div>

  <!-- QUESTIONS -->
  <div class="quiz-screen hidden" id="quiz-questions">
    <div class="question-header">
      <div class="question-counter">
        QUESTION <span id="current-q">1</span> OF {quiz.questions.length}
      </div>

      <div class="question-dots" id="question-dots"></div>
    </div>

    <div class="question-container" id="question-container"></div>
  </div>

  <!-- LOADING -->
  <div class="quiz-screen hidden" id="quiz-loading">
    <div class="loading-content">
      <div class="movie-loader">
        <div class="loader-ring"></div>
        <div class="loader-film">🎬</div>
      </div>

      <div class="cinema-label">YOUR MOVIE IS BEING CAST</div>

      <p class="loading-message" id="loading-message">
        Analyzing your movie personality...
      </p>
    </div>
  </div>

  <!-- ERROR -->
  <div class="quiz-screen hidden" id="quiz-error">
    <div class="error-content">
      <div class="error-icon">⚠</div>

      <p class="error-title">We couldn't create your result.</p>

      <p class="error-desc" id="error-desc">
        Something went wrong during generation. Please try again.
      </p>

      <button class="btn-primary" id="retry-btn">
        <span>Try Again</span>
        <span class="btn-arrow">↻</span>
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ quiz }}>
  (function() {
    const player = document.querySelector('.quiz-player');
    if (!player) return;

    const startScreen = document.getElementById('quiz-start');
    const genderScreen = document.getElementById('quiz-gender');
    const questionsScreen = document.getElementById('quiz-questions');
    const loadingScreen = document.getElementById('quiz-loading');
    const errorScreen = document.getElementById('quiz-error');

    const startBtn = document.getElementById('start-btn');
    const retryBtn = document.getElementById('retry-btn');

    const questionContainer = document.getElementById('question-container');
    const progressFill = document.getElementById('progress-fill');
    const currentQSpan = document.getElementById('current-q');
    const loadingMessage = document.getElementById('loading-message');
    const errorDesc = document.getElementById('error-desc');
    const dotsContainer = document.getElementById('question-dots');

    let currentQuestion = 0;
    let answers = {};
    let gender = '';
    let isGenerating = false;

    const loadingMessages = [
      'Analyzing your movie personality...',
      'Finding your cinematic alter ego...',
      'Casting your character...',
      'Creating your movie poster...',
      'Your result is ready.'
    ];

    // Build question progress dots
    for (let i = 0; i < quiz.questions.length; i++) {
      const dot = document.createElement('span');
      dot.className = 'q-dot';
      dotsContainer.appendChild(dot);
    }

    const dots = dotsContainer.querySelectorAll('.q-dot');

    function showScreen(screen) {
      [
        startScreen,
        genderScreen,
        questionsScreen,
        loadingScreen,
        errorScreen
      ].forEach(s => s.classList.add('hidden'));

      screen.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateProgress() {
      const progress =
        (currentQuestion / quiz.questions.length) * 100;

      progressFill.style.width = progress + '%';

      dots.forEach((d, i) => {
        d.classList.remove('active', 'done');

        if (i < currentQuestion) {
          d.classList.add('done');
        }

        if (i === currentQuestion) {
          d.classList.add('active');
        }
      });
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderQuestion(index) {
      const q = quiz.questions[index];

      if (!q) return;

      currentQSpan.textContent = index + 1;
      updateProgress();

      questionContainer.innerHTML = `
        <div class="millionaire-stage">
          <div class="stage-glow"></div>

          <div class="question-card">
            <div class="question-corner top-left"></div>
            <div class="question-corner top-right"></div>
            <div class="question-corner bottom-left"></div>
            <div class="question-corner bottom-right"></div>

            <div class="question-number-badge">
              QUESTION ${index + 1}
            </div>

            <div class="question-text">
              ${escapeHtml(q.text)}
            </div>
          </div>

          <div class="answers">
            ${q.answers.map((a, i) => `
              <button
                class="answer-card"
                data-answer-id="${escapeHtml(a.id)}"
                data-question-id="${escapeHtml(q.id)}"
                style="animation-delay:${i * 0.08}s"
              >
                <span class="answer-letter">
                  ${String.fromCharCode(65 + i)}
                </span>

                <span class="answer-text">
                  ${escapeHtml(a.text)}
                </span>
              </button>
            `).join('')}
          </div>
        </div>
      `;

      questionContainer
        .querySelectorAll('.answer-card')
        .forEach(card => {
          card.addEventListener('click', function() {
            if (this.classList.contains('selected')) return;

            const qId = this.dataset.questionId;
            const aId = this.dataset.answerId;

            answers[qId] = aId;

            this.classList.add('selected');

            // Prevent double clicks
            questionContainer
              .querySelectorAll('.answer-card')
              .forEach(c => {
                c.style.pointerEvents = 'none';
              });

            setTimeout(() => {
              if (currentQuestion < quiz.questions.length - 1) {
                currentQuestion++;
                renderQuestion(currentQuestion);
              } else {
                submitQuiz();
              }
            }, 450);
          });
        });
    }

    async function submitQuiz() {
      if (isGenerating) return;

      if (!gender) {
        showScreen(genderScreen);
        return;
      }

      isGenerating = true;

      showScreen(loadingScreen);

      progressFill.style.width = '100%';

      dots.forEach(d => {
        d.classList.remove('active');
        d.classList.add('done');
      });

      let msgIndex = 0;

      loadingMessage.textContent = loadingMessages[0];

      const msgInterval = setInterval(() => {
        msgIndex = Math.min(
          msgIndex + 1,
          loadingMessages.length - 2
        );

        loadingMessage.textContent = loadingMessages[msgIndex];
      }, 3000);

      try {
        const response = await fetch('/api/generate-result', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            quizId: quiz.id,
            gender: gender,
            answers: answers
          })
        });

        const data = await response.json();

        clearInterval(msgInterval);

        if (!response.ok) {
          throw new Error(
            data.error || 'Generation failed'
          );
        }

        loadingMessage.textContent = loadingMessages[4];

        setTimeout(() => {
          window.location.href =
            '/result/' + data.resultId;
        }, 800);

      } catch (err) {
        clearInterval(msgInterval);

        isGenerating = false;

        errorDesc.textContent =
          err instanceof Error
            ? err.message
            : 'Something went wrong during generation. Please try again.';

        showScreen(errorScreen);
      }
    }

    // Start button -> gender selection
    startBtn.addEventListener('click', () => {
      currentQuestion = 0;
      answers = {};
      gender = '';
      isGenerating = false;

      progressFill.style.width = '0%';

      dots.forEach(d => {
        d.classList.remove('active', 'done');
      });

      showScreen(genderScreen);
    });

    // Gender selection
    document
      .querySelectorAll('.gender-card')
      .forEach(card => {
        card.addEventListener('click', function() {
          const selectedGender = this.dataset.gender;

          if (
            selectedGender !== 'male' &&
            selectedGender !== 'female'
          ) {
            return;
          }

          gender = selectedGender;

          document
            .querySelectorAll('.gender-card')
            .forEach(c => {
              c.classList.remove('selected');
            });

          this.classList.add('selected');

          setTimeout(() => {
            currentQuestion = 0;
            answers = {};

            showScreen(questionsScreen);
            renderQuestion(0);
          }, 300);
        });
      });

    // Retry -> start screen
    retryBtn.addEventListener('click', () => {
      isGenerating = false;
      answers = {};
      gender = '';
      currentQuestion = 0;

      progressFill.style.width = '0%';

      dots.forEach(d => {
        d.classList.remove('active', 'done');
      });

      showScreen(startScreen);
    });

    // Keyboard shortcuts 1-4
    document.addEventListener('keydown', (e) => {
      if (questionsScreen.classList.contains('hidden')) {
        return;
      }

      if (e.key >= '1' && e.key <= '4') {
        const cards =
          questionContainer.querySelectorAll('.answer-card');

        const idx = parseInt(e.key, 10) - 1;

        if (cards[idx]) {
          cards[idx].click();
        }
      }
    });
  })();
</script>

<style is:global>
  .quiz-player {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 88px 20px 50px;
    overflow: hidden;
  }

  .quiz-player::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -2;
    background:
      radial-gradient(
        circle at 50% 18%,
        rgba(229, 9, 20, 0.13),
        transparent 34%
      ),
      radial-gradient(
        circle at 50% 75%,
        rgba(212, 167, 44, 0.055),
        transparent 38%
      );
  }

  .quiz-player::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    opacity: 0.3;
    background-image:
      linear-gradient(
        rgba(255,255,255,0.018) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.018) 1px,
        transparent 1px
      );
    background-size: 45px 45px;
  }

  /* =========================
     PROGRESS
  ========================= */

  .quiz-progress-bar {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    height: 4px;
    background: rgba(255,255,255,0.07);
    z-index: 100;
  }

  .quiz-progress-fill {
    width: 0%;
    height: 100%;
    background:
      linear-gradient(
        90deg,
        #8b0000,
        #e50914,
        #ffb300
      );
    box-shadow:
      0 0 12px rgba(229,9,20,0.7);
    transition:
      width 0.45s cubic-bezier(0.4,0,0.2,1);
  }

  /* =========================
     SCREENS
  ========================= */

  .quiz-screen {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: quizFadeIn 0.45s ease;
  }

  .quiz-screen.hidden {
    display: none;
  }

  @keyframes quizFadeIn {
    from {
      opacity: 0;
      transform: translateY(15px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =========================
     INTRO
  ========================= */

  .quiz-start-content {
    width: 100%;
    max-width: 560px;
    padding: 35px 0;
    text-align: center;
  }

  .quiz-emoji {
    display: block;
    font-size: 4rem;
    margin-bottom: 18px;
    filter:
      drop-shadow(0 0 25px rgba(229,9,20,0.25));
  }

  .cinema-label {
    margin-bottom: 15px;
    color: #d4a72c;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.25em;
  }

  .quiz-title {
    margin: 0 0 14px;
    font-size: clamp(2rem, 7vw, 3rem);
    line-height: 1.1;
    font-weight: 800;
  }

  .quiz-subtitle {
    margin: 0 0 18px;
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .quiz-description {
    max-width: 470px;
    margin: 0 auto 28px;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .quiz-stats {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  .quiz-stats span {
    padding: 8px 14px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    background: rgba(255,255,255,0.04);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* =========================
     PRIMARY BUTTON
  ========================= */

  .btn-primary {
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 0 30px;

    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;

    background:
      linear-gradient(
        135deg,
        #b0060e,
        #e50914
      );

    color: white;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;

    box-shadow:
      0 12px 35px rgba(229,9,20,0.25);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow:
      0 16px 45px rgba(229,9,20,0.4);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-arrow {
    font-size: 1.3rem;
  }

  /* =========================
     GENDER
  ========================= */

  .gender-content {
    width: 100%;
    max-width: 580px;
    text-align: center;
  }

  .gender-icon {
    width: 82px;
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 5px auto 20px;

    border-radius: 24px;
    border: 1px solid rgba(229,9,20,0.25);

    background:
      linear-gradient(
        135deg,
        rgba(229,9,20,0.15),
        rgba(212,167,44,0.08)
      );

    font-size: 2.8rem;

    box-shadow:
      0 15px 40px rgba(229,9,20,0.12);
  }

  .gender-title {
    margin: 0 0 15px;
    font-size: clamp(1.5rem, 5vw, 2.1rem);
    line-height: 1.25;
  }

  .gender-subtitle {
    max-width: 470px;
    margin: 0 auto 30px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .gender-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 460px;
    margin: 0 auto;
  }

  .gender-card {
    position: relative;
    min-height: 155px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;

    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,0.065),
        rgba(255,255,255,0.02)
      );

    color: var(--color-text);
    cursor: pointer;

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease;
  }

  .gender-card:hover {
    transform: translateY(-4px);
    border-color: rgba(229,9,20,0.6);
    background:
      linear-gradient(
        145deg,
        rgba(229,9,20,0.12),
        rgba(255,255,255,0.03)
      );
  }

  .gender-card.selected {
    border-color: #e50914;
    background:
      linear-gradient(
        145deg,
        rgba(229,9,20,0.2),
        rgba(229,9,20,0.05)
      );

    box-shadow:
      0 0 30px rgba(229,9,20,0.2);
  }

  .gender-symbol {
    font-size: 2.8rem;
    color: #d4a72c;
  }

  .gender-label {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gender-check {
    position: absolute;
    top: 12px;
    right: 14px;
    opacity: 0;
    color: #ffb300;
    font-weight: 900;
  }

  .gender-card.selected .gender-check {
    opacity: 1;
  }

  .gender-note {
    margin-top: 20px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  /* =========================
     QUESTION HEADER
  ========================= */

  .question-header {
    width: 100%;
    max-width: 900px;
    margin: 0 auto 25px;
    text-align: center;
  }

  .question-counter {
    margin-bottom: 13px;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .question-counter span {
    color: #ffb300;
    font-size: 1rem;
  }

  .question-dots {
    display: flex;
    justify-content: center;
    gap: 5px;
  }

  .q-dot {
    width: 24px;
    height: 4px;
    border-radius: 999px;
    background: rgba(255,255,255,0.09);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .q-dot.active {
    background: #e50914;
    box-shadow:
      0 0 10px rgba(229,9,20,0.75);
    transform: scaleY(1.3);
  }

  .q-dot.done {
    background: rgba(229,9,20,0.42);
  }

  /* =========================
     QUESTION CONTAINER
  ========================= */

  .question-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  .millionaire-stage {
    position: relative;
    width: 100%;
  }

  .stage-glow {
    position: absolute;
    top: -60px;
    left: 15%;
    width: 70%;
    height: 350px;
    pointer-events: none;

    background:
      radial-gradient(
        ellipse,
        rgba(229,9,20,0.12),
        transparent 70%
      );

    filter: blur(25px);
  }

  /* =========================
     QUESTION CARD
  ========================= */

  .question-card {
    position: relative;
    z-index: 2;

    min-height: 175px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 42px 45px;
    margin-bottom: 22px;

    border: 1px solid rgba(212,167,44,0.48);
    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        rgba(25,25,33,0.98),
        rgba(8,8,13,0.99)
      );

    box-shadow:
      0 25px 70px rgba(0,0,0,0.45),
      inset 0 1px rgba(255,255,255,0.06);

    overflow: hidden;
  }

  .question-card::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 21px;
    pointer-events: none;

    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(212,167,44,0.08),
        transparent 55%
      );
  }

  .question-card::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 12px;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(212,167,44,0.35),
        transparent
      );
  }

  .question-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: rgba(212,167,44,0.7);
    border-style: solid;
  }

  .question-corner.top-left {
    top: 10px;
    left: 10px;
    border-width: 1px 0 0 1px;
  }

  .question-corner.top-right {
    top: 10px;
    right: 10px;
    border-width: 1px 1px 0 0;
  }

  .question-corner.bottom-left {
    bottom: 10px;
    left: 10px;
    border-width: 0 0 1px 1px;
  }

  .question-corner.bottom-right {
    bottom: 10px;
    right: 10px;
    border-width: 0 1px 1px 0;
  }

  .question-number-badge {
    position: relative;
    z-index: 2;
    margin-bottom: 16px;

    color: #d4a72c;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.25em;
  }

  .question-text {
    position: relative;
    z-index: 2;

    max-width: 720px;

    color: var(--color-text);

    font-size: clamp(1.15rem, 3vw, 1.55rem);
    font-weight: 700;
    line-height: 1.45;
    text-align: center;
  }

  /* =========================
     ANSWERS
  ========================= */

  .answers {
    position: relative;
    z-index: 2;

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .answer-card {
    position: relative;

    min-height: 82px;

    display: flex;
    align-items: center;

    padding: 12px 18px 12px 13px;

    border: 1px solid rgba(255,255,255,0.13);
    border-radius: 16px;

    background:
      linear-gradient(
        135deg,
        rgba(27,27,36,0.98),
        rgba(10,10,16,0.98)
      );

    color: var(--color-text);

    cursor: pointer;
