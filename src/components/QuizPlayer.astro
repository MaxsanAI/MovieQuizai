---
import type { Quiz } from '../types';

interface Props {
  quiz: Quiz;
}

const { quiz } = Astro.props;
---

<div class="quiz-player" data-quiz-id={quiz.id} data-quiz-slug={quiz.slug}>
  <div class="quiz-progress-bar">
    <div class="quiz-progress-fill" id="progress-fill"></div>
  </div>

  <!-- INTRO -->
  <div class="quiz-screen" id="quiz-start">
    <div class="quiz-start-content">
      <span class="quiz-emoji">{quiz.emoji}</span>

      <div class="cinema-label">MOVIEQUIZ PRESENTS</div>

      <h1 class="quiz-title">{quiz.title}</h1>

      <p class="quiz-subtitle">{quiz.subtitle}</p>

      <p class="quiz-description">{quiz.description}</p>

      <div class="quiz-stats">
        <span>{quiz.questions.length} Questions</span>
        <span>{quiz.results.length} Possible Results</span>
      </div>

      <button class="btn-primary" id="start-btn">
        <span>Start Quiz</span>
        <span class="btn-arrow">→</span>
      </button>
    </div>
  </div>

  <!-- GENDER SELECTION -->
  <div class="quiz-screen hidden" id="quiz-gender">
    <div class="gender-content">
      <div class="cinema-label">PERSONALIZE YOUR RESULT</div>

      <div class="gender-icon">🎬</div>

      <h2 class="gender-title">
        How should we personalize<br />
        your movie character?
      </h2>

      <p class="gender-subtitle">
        Choose your gender so the final character reveal and movie poster
        can be personalized for you.
      </p>

      <div class="gender-options">
        <button class="gender-card" data-gender="male">
          <span class="gender-symbol">♂</span>
          <span class="gender-label">Male</span>
          <span class="gender-check">✓</span>
        </button>

        <button class="gender-card" data-gender="female">
          <span class="gender-symbol">♀</span>
          <span class="gender-label">Female</span>
          <span class="gender-check">✓</span>
        </button>
      </div>

      <p class="gender-note">
        This only affects your personalized result.
      </p>
    </div>
  </div>

  <!-- QUESTIONS -->
  <div class="quiz-screen hidden" id="quiz-questions">
    <div class="question-header">
      <div class="question-counter">
        QUESTION <span id="current-q">1</span> OF {quiz.questions.length}
      </div>

      <div class="question-dots" id="question-dots"></div>
    </div>

    <div class="question-container" id="question-container"></div>
  </div>

  <!-- LOADING -->
  <div class="quiz-screen hidden" id="quiz-loading">
    <div class="loading-content">
      <div class="movie-loader">
        <div class="loader-ring"></div>
        <div class="loader-film">🎬</div>
      </div>

      <div class="cinema-label">YOUR MOVIE IS BEING CAST</div>

      <p class="loading-message" id="loading-message">
        Analyzing your movie personality...
      </p>
    </div>
  </div>

  <!-- ERROR -->
  <div class="quiz-screen hidden" id="quiz-error">
    <div class="error-content">
      <div class="error-icon">⚠</div>

      <p class="error-title">We couldn't create your result.</p>

      <p class="error-desc" id="error-desc">
        Something went wrong during generation. Please try again.
      </p>

      <button class="btn-primary" id="retry-btn">
        <span>Try Again</span>
        <span class="btn-arrow">↻</span>
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ quiz }}>
  (function() {
    const player = document.querySelector('.quiz-player');
    if (!player) return;

    const startScreen = document.getElementById('quiz-start');
    const genderScreen = document.getElementById('quiz-gender');
    const questionsScreen = document.getElementById('quiz-questions');
    const loadingScreen = document.getElementById('quiz-loading');
    const errorScreen = document.getElementById('quiz-error');

    const startBtn = document.getElementById('start-btn');
    const retryBtn = document.getElementById('retry-btn');

    const questionContainer = document.getElementById('question-container');
    const progressFill = document.getElementById('progress-fill');
    const currentQSpan = document.getElementById('current-q');
    const loadingMessage = document.getElementById('loading-message');
    const errorDesc = document.getElementById('error-desc');
    const dotsContainer = document.getElementById('question-dots');

    let currentQuestion = 0;
    let answers = {};
    let gender = '';
    let isGenerating = false;

    const loadingMessages = [
      'Analyzing your movie personality...',
      'Finding your cinematic alter ego...',
      'Casting your character...',
      'Creating your movie poster...',
      'Your result is ready.'
    ];

    // Build question progress dots
    for (let i = 0; i < quiz.questions.length; i++) {
      const dot = document.createElement('span');
      dot.className = 'q-dot';
      dotsContainer.appendChild(dot);
    }

    const dots = dotsContainer.querySelectorAll('.q-dot');

    function showScreen(screen) {
      [
        startScreen,
        genderScreen,
        questionsScreen,
        loadingScreen,
        errorScreen
      ].forEach(s => s.classList.add('hidden'));

      screen.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateProgress() {
      const progress =
        (currentQuestion / quiz.questions.length) * 100;

      progressFill.style.width = progress + '%';

      dots.forEach((d, i) => {
        d.classList.remove('active', 'done');

        if (i < currentQuestion) {
          d.classList.add('done');
        }

        if (i === currentQuestion) {
          d.classList.add('active');
        }
      });
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderQuestion(index) {
      const q = quiz.questions[index];

      if (!q) return;

      currentQSpan.textContent = index + 1;
      updateProgress();

      questionContainer.innerHTML = `
        <div class="millionaire-stage">
          <div class="stage-glow"></div>

          <div class="question-card">
            <div class="question-corner top-left"></div>
            <div class="question-corner top-right"></div>
            <div class="question-corner bottom-left"></div>
            <div class="question-corner bottom-right"></div>

            <div class="question-number-badge">
              QUESTION ${index + 1}
            </div>

            <div class="question-text">
              ${escapeHtml(q.text)}
            </div>
          </div>

          <div class="answers">
            ${q.answers.map((a, i) => `
              <button
                class="answer-card"
                data-answer-id="${escapeHtml(a.id)}"
                data-question-id="${escapeHtml(q.id)}"
                style="animation-delay:${i * 0.08}s"
              >
                <span class="answer-letter">
                  ${String.fromCharCode(65 + i)}
                </span>

                <span class="answer-text">
                  ${escapeHtml(a.text)}
                </span>
              </button>
            `).join('')}
          </div>
        </div>
      `;

      questionContainer
        .querySelectorAll('.answer-card')
        .forEach(card => {
          card.addEventListener('click', function() {
            if (this.classList.contains('selected')) return;

            const qId = this.dataset.questionId;
            const aId = this.dataset.answerId;

            answers[qId] = aId;

            this.classList.add('selected');

            // Prevent double clicks
            questionContainer
              .querySelectorAll('.answer-card')
              .forEach(c => {
                c.style.pointerEvents = 'none';
              });

            setTimeout(() => {
              if (currentQuestion < quiz.questions.length - 1) {
                currentQuestion++;
                renderQuestion(currentQuestion);
              } else {
                submitQuiz();
              }
            }, 450);
          });
        });
    }

    async function submitQuiz() {
      if (isGenerating) return;

      if (!gender) {
        showScreen(genderScreen);
        return;
      }

      isGenerating = true;

      showScreen(loadingScreen);

      progressFill.style.width = '100%';

      dots.forEach(d => {
        d.classList.remove('active');
        d.classList.add('done');
      });

      let msgIndex = 0;

      loadingMessage.textContent = loadingMessages[0];

      const msgInterval = setInterval(() => {
        msgIndex = Math.min(
          msgIndex + 1,
          loadingMessages.length - 2
        );

        loadingMessage.textContent = loadingMessages[msgIndex];
      }, 3000);

      try {
        const response = await fetch('/api/generate-result', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            quizId: quiz.id,
            gender: gender,
            answers: answers
          })
        });

        const data = await response.json();

        clearInterval(msgInterval);

        if (!response.ok) {
          throw new Error(
            data.error || 'Generation failed'
          );
        }

        loadingMessage.textContent = loadingMessages[4];

        setTimeout(() => {
          window.location.href =
            '/result/' + data.resultId;
        }, 800);

      } catch (err) {
        clearInterval(msgInterval);

        isGenerating = false;

        errorDesc.textContent =
          err instanceof Error
            ? err.message
            : 'Something went wrong during generation. Please try again.';

        showScreen(errorScreen);
      }
    }

    // Start button -> gender selection
    startBtn.addEventListener('click', () => {
      currentQuestion = 0;
      answers = {};
      gender = '';
      isGenerating = false;

      progressFill.style.width = '0%';

      dots.forEach(d => {
        d.classList.remove('active', 'done');
      });

      showScreen(genderScreen);
    });

    // Gender selection
    document
      .querySelectorAll('.gender-card')
      .forEach(card => {
        card.addEventListener('click', function() {
          const selectedGender = this.dataset.gender;

          if (
            selectedGender !== 'male' &&
            selectedGender !== 'female'
          ) {
            return;
          }

          gender = selectedGender;

          document
            .querySelectorAll('.gender-card')
            .forEach(c => {
              c.classList.remove('selected');
            });

          this.classList.add('selected');

          setTimeout(() => {
            currentQuestion = 0;
            answers = {};

            showScreen(questionsScreen);
            renderQuestion(0);
          }, 300);
        });
      });

    // Retry -> start screen
    retryBtn.addEventListener('click', () => {
      isGenerating = false;
      answers = {};
      gender = '';
      currentQuestion = 0;

      progressFill.style.width = '0%';

      dots.forEach(d => {
        d.classList.remove('active', 'done');
      });

      showScreen(startScreen);
    });

    // Keyboard shortcuts 1-4
    document.addEventListener('keydown', (e) => {
      if (questionsScreen.classList.contains('hidden')) {
        return;
      }

      if (e.key >= '1' && e.key <= '4') {
        const cards =
          questionContainer.querySelectorAll('.answer-card');

        const idx = parseInt(e.key, 10) - 1;

        if (cards[idx]) {
          cards[idx].click();
        }
      }
    });
  })();
</script>

<style>
  .quiz-player {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 80px 20px 50px;
    position: relative;
    overflow: hidden;
  }

  .quiz-player::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 20%,
        rgba(229, 9, 20, 0.08),
        transparent 38%
      );
    z-index: -1;
  }

  .quiz-progress-bar {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    height: 4px;
    background: rgba(255, 255, 255, 0.06);
    z-index: 50;
  }

  .quiz-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(
      90deg,
      #8b0000,
      #e50914,
      #ffb300
    );
    box-shadow: 0 0 12px rgba(229, 9, 20, 0.7);
    transition:
      width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .quiz-screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.4s ease;
  }

  .quiz-screen.hidden {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --------------------------------
     INTRO
  -------------------------------- */

  .quiz-start-content {
    max-width: 520px;
    text-align: center;
    padding: 35px 0;
  }

  .cinema-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.25em;
    color: #d4a72c;
    margin-bottom: 16px;
  }

  .quiz-emoji {
    font-size: 3.5rem;
    display: block;
    margin-bottom: 14px;
    filter: drop-shadow(
      0 0 20px rgba(255, 180, 0, 0.2)
    );
  }

  .quiz-title {
    font-size: 2.15rem;
    margin-bottom: 14px;
    line-height: 1.12;
  }

  .quiz-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .quiz-description {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .quiz-stats {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 34px;
    flex-wrap: wrap;
  }

  .quiz-stats span {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    padding: 8px 15px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 15px 34px;
    background:
      linear-gradient(
        135deg,
        #9b0000,
        #e50914
      );
    color: white;
    font-size: 1.05rem;
    font-weight: 800;
    border-radius: 4px;
    border: 1px solid rgba(255, 180, 80, 0.25);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    box-shadow:
      0 5px 25px rgba(229, 9, 20, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.15);
    min-height: 54px;
    cursor: pointer;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 8px 35px rgba(229, 9, 20, 0.45),
      inset 0 1px rgba(255, 255, 255, 0.2);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-arrow {
    font-size: 1.35rem;
  }

  /* --------------------------------
     GENDER
  -------------------------------- */

  .gender-content {
    width: 100%;
    max-width: 560px;
    text-align: center;
    padding: 30px 0;
  }

  .gender-icon {
    font-size: 3rem;
    margin: 8px 0 18px;
    filter: drop-shadow(
      0 0 20px rgba(229, 9, 20, 0.3)
    );
  }

  .gender-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1.25;
    margin: 0 0 14px;
  }

  .gender-subtitle {
    color: var(--color-text-secondary);
    max-width: 450px;
    margin: 0 auto 30px;
    line-height: 1.55;
  }

  .gender-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 430px;
    margin: 0 auto;
  }

  .gender-card {
    position: relative;
    min-height: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    color: var(--color-text);
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0.025)
      );
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    transition: all 0.25s ease;
  }

  .gender-card:hover {
    border-color: rgba(229, 9, 20, 0.7);
    background: rgba(229, 9, 20, 0.08);
    transform: translateY(-3px);
  }

  .gender-card.selected {
    border-color: #e50914;
    background:
      linear-gradient(
        145deg,
        rgba(229, 9, 20, 0.2),
        rgba(229, 9, 20, 0.06)
      );
    box-shadow:
      0 0 25px rgba(229, 9, 20, 0.22),
      inset 0 0 25px rgba(229, 9, 20, 0.05);
  }

  .gender-symbol {
    font-size: 2.8rem;
    line-height: 1;
    color: #d4a72c;
  }

  .gender-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gender-check {
    position: absolute;
    top: 10px;
    right: 12px;
    opacity: 0;
    color: #ffb300;
    font-weight: 900;
    transition: opacity 0.2s ease;
  }

  .gender-card.selected .gender-check {
    opacity: 1;
  }

  .gender-note {
    margin-top: 22px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  /* --------------------------------
     QUESTION HEADER
  -------------------------------- */

  .question-header {
    width: 100%;
    max-width: 850px;
    margin: 0 auto 26px;
    text-align: center;
  }

  .question-counter {
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    letter-spacing: 0.18em;
    margin-bottom: 13px;
  }

  .question-counter span {
    color: #d4a72c;
    font-weight: 900;
  }

  .question-dots {
    display: flex;
    justify-content: center;
    gap: 5px;
  }

  .q-dot {
    width: 25px;
    height: 3px;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .q-dot.active {
    background: #e50914;
    box-shadow: 0 0 8px rgba(229, 9, 20, 0.7);
  }

  .q-dot.done {
    background: rgba(229, 9, 20, 0.45);
  }

  /* --------------------------------
     MILLIONAIRE-INSPIRED STAGE
  -------------------------------- */

  .question-container {
    max-width: 850px;
    width: 100%;
    margin: 0 auto;
  }

  .millionaire-stage {
    position: relative;
    width: 100%;
  }

  .stage-glow {
    position: absolute;
    width: 70%;
    height: 300px;
    left: 15%;
    top: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse,
        rgba(229, 9, 20, 0.12),
        transparent 70%
      );
    filter: blur(20px);
  }

  .question-card {
    position: relative;
    z-index: 1;
    min-height: 145px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 35px 35px;
    margin-bottom: 24px;

    background:
      linear-gradient(
        180deg,
        rgba(17, 17, 25, 0.98),
        rgba(7, 7, 12, 0.98)
      );

    border: 2px solid #76613b;
    border-radius: 5px;

    box-shadow:
      0 0 0 5px rgba(255, 255, 255, 0.025),
      0 15px 45px rgba(0, 0, 0, 0.45),
      inset 0 0 35px rgba(0, 0, 0, 0.65);

    overflow: hidden;
  }

  .question-card::before,
  .question-card::after {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(212, 167, 44, 0.65),
      transparent
    );
  }

  .question-card::before {
    top: 12px;
  }

  .question-card::after {
    bottom: 12px;
  }

  .question-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: #c49a32;
    border-style: solid;
    opacity: 0.8;
  }

  .question-corner.top-left {
    top: 6px;
    left: 6px;
    border-width: 2px 0 0 2px;
  }

  .question-corner.top-right {
    top: 6px;
    right: 6px;
    border-width: 2px 2px 0 0;
  }

  .question-corner.bottom-left {
    bottom: 6px;
    left: 6px;
    border-width: 0 0 2px 2px;
  }

  .question-corner.bottom-right {
    bottom: 6px;
    right: 6px;
    border-width: 0 2px 2px 0;
  }

  .question-number-badge {
    position: relative;
    z-index: 2;
    margin-bottom: 16px;
    color: #d4a72c;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .question-text {
    position: relative;
    z-index: 2;
    max-width: 700px;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.4;
    text-align: center;
  }

  /* --------------------------------
     ANSWERS
  -------------------------------- */

  .answers {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 13px 16px;
  }

  .answer-card {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 76px;
    padding: 13px 20px 13px 14px;

    background:
      linear-gradient(
        100deg,
        rgba(19, 19, 28, 0.98),
        rgba(8, 8, 14, 0.98)
      );

    color: var(--color-text);

    border: 2px solid #574d3a;
    border-radius: 5px;

    box-shadow:
      inset 0 0 20px rgba(0, 0, 0, 0.35),
      0 5px 15px rgba(0, 0, 0, 0.25);

    font-size: 0.98rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;

    animation: answerAppear 0.4s ease both;
  }

  @keyframes answerAppear {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .answer-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 13px;
    bottom: 13px;
    width: 3px;
    background: transparent;
    border-radius: 2px;
    transition: background 0.2s ease;
  }

  .answer-card:hover {
    transform: translateY(-2px);
    border-color: #9b7d36;
    background:
      linear-gradient(
        100deg,
        rgba(51, 38, 23, 0.98),
        rgba(15, 12, 12, 0.98)
      );
    box-shadow:
      0 8px 22px rgba(0, 0, 0, 0.35),
      0 0 18px rgba(212, 167, 44, 0.08);
  }

  .answer-card:hover::before {
    background: #d4a72c;
  }

  .answer-card:active {
    transform: scale(0.985);
  }

  .answer-card.selected {
    border-color: #e50914;
